# Create a private .env file from this example.
# Use a long, unique password. Never commit your .env file.
ADMIN_USER=balo
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
PORT=3000
# On hosts with persistent storage, set this to a path on the persistent disk.
DB_PATH=./data/orders.db
# If hosted behind a trusted reverse proxy, set to 1; otherwise leave at 0.
TRUST_PROXY=0
